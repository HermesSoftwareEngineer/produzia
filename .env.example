# Login do Produzia
APP_USER=admin
APP_PASSWORD=
# Gere com: openssl rand -hex 32
SECRET_KEY=

# Credenciais da API do Trello (https://trello.com/power-ups/admin -> API key / token).
# A chave tambem e usada no "Entrar com Trello": adicione o dominio do Produzia em Allowed origins.
# O token e o do administrador (login APP_USER/APP_PASSWORD).
TRELLO_KEY=
TRELLO_TOKEN=

# API do Power-Up de checklists (trello-power). Na VPS, pela rede docker interna.
POWERUP_API_URL=http://trello-power:5000/api
POWERUP_API_KEY=

TIMEZONE=America/Sao_Paulo

# Chave de servico usada pelo servidor MCP para falar com a API (header X-API-Key).
# Gere com: openssl rand -hex 32
PRODUZIA_API_KEY=

# Servidor MCP (produzia-mcp): token exigido dos clientes em "Authorization: Bearer <token>".
# Gere com: openssl rand -hex 32
MCP_TOKEN=
# URL interna da API do Produzia, vista de dentro da rede docker.
PRODUZIA_API_URL=http://produzia:5000/api
